* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: Arial, sans-serif;
  background: #f4f7fb;
  color: #222;
  line-height: 1.6;
}

header {
  background: #0b6bcb;
  color: white;
  padding: 20px;
  text-align: center;
}

header h1 {
  font-size: 32px;
  margin-bottom: 8px;
}

nav {
  background: white;
  padding: 12px;
  text-align: center;
  box-shadow: 0 2px 6px rgba(0,0,0,0.1);
}

nav a {
  color: #0b6bcb;
  text-decoration: none;
  margin: 0 10px;
  font-weight: bold;
}

main {
  max-width: 1000px;
  margin: 30px auto;
  padding: 20px;
}

section {
  background: white;
  padding: 25px;
  margin-bottom: 20px;
  border-radius: 12px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.08);
}

h2 {
  color: #0b6bcb;
  margin-bottom: 15px;
}

p {
  margin-bottom: 10px;
}

button {
  background: #0b6bcb;
  color: white;
  border: none;
  padding: 12px 20px;
  border-radius: 8px;
  cursor: pointer;
  font-size: 16px;
}

button:hover {
  background: #084f99;
}

input,
textarea,
select {
  width: 100%;
  padding: 12px;
  margin: 8px 0 15px;
  border: 1px solid #ccc;
  border-radius: 8px;
  font-size: 16px;
}

footer {
  background: #222;
  color: white;
  text-align: center;
  padding: 20px;
  margin-top: 30px;
}

@media (max-width: 600px) {
  header h1 {
    font-size: 26px;
  }

  main {
    padding: 12px;
    margin: 15px auto;
  }

  section {
    padding: 18px;
  }

  nav a {
    display: inline-block;
    margin: 5px;
  }
}
